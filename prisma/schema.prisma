// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  blowerConfigs BlowerConfig[]
  pressureReadings PressureReading[]

  @@map("tenants")
}

model User {
  id     String @id @default(uuid()) @db.Uuid
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tenantId String? @db.Uuid
  username String
  email    String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  credential Credential?

  @@index([tenantId])
  @@map("users")
}

model Credential {
  id String @id @default(uuid()) @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.Uuid

  password String
  @@map("credentials")
}

model Session {
  id           String  @id @default(uuid()) @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String  @db.Uuid
  refreshToken String  @unique
  isActive     Boolean @default(true)

  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @updatedAt

  @@index([userId])
  @@map("sessions")
}

model BlowerConfig {
  id String   @id @default(uuid()) @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String   @db.Uuid
  
  blowerId String
  name String? 
  currentThreshold Float @default(2.0)

  firmwareVersion String?
  wifiRssi        Int?
  uptimeMs        Int?
  freeHeap        Int?
  readIntervalMs  Int?    @default(1000)
  scaleFactor     Float?  @default(25000.0)
  saveIntervalSeconds Int @default(10800)
  lastSaveAt DateTime?
  lastAlertState Boolean @default(false)

  pressureReadings PressureReading[]
  deviceKeys DeviceKey[]
  
  @@unique([tenantId, blowerId])
  @@map("blower_config")
}

model DeviceKey {
  id String  @id @default(uuid()) @db.Uuid
  key String  @unique
  isActive Boolean @default(true)
  
  blowerConfig BlowerConfig @relation(fields: [blowerConfigId], references: [id], onDelete: Cascade)
  blowerConfigId String  @db.Uuid
  
  createdAt DateTime @default(now())

  @@index([key])
  @@index([blowerConfigId])
  @@map("device_key")
}

model PressureReading {
  id BigInt @id @default(autoincrement())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @db.Uuid
  
  blowerConfig   BlowerConfig? @relation(fields: [blowerConfigId], references: [id], onDelete: SetNull)
  blowerConfigId String? @db.Uuid 
  
  psi Float
  isAlert Boolean @default(false)
  deviceTs BigInt?
  deviceTime DateTime?
  source String @default("scheduled")
  
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([blowerConfigId])
  @@index([createdAt])
  @@index([tenantId, isAlert])

  @@map("pressure_reading")
}
